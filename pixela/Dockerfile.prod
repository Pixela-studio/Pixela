# syntax=docker/dockerfile:1

# Imagen de produccion. El `Dockerfile` de al lado sigue siendo el de
# desarrollo y no se toca: nunca ejecuta `build` y termina en
# `CMD ["bun", "run", "dev"]`, asi que servia para levantar el proyecto en
# local pero no para publicarlo.
#
# Tres decisiones gobiernan este fichero, y las tres vienen de un problema
# concreto que da la cara en runtime, no en build:
#
#   1. Dos imagenes base, ambas Debian bookworm. Se construye con bun (es el
#      gestor del proyecto, `packageManager: bun@1.3.8`) y se ejecuta con Node
#      (`engines.node >= 20`, y el `server.js` de standalone esta pensado para
#      Node). Lo que las une es que comparten libc y OpenSSL 3, que es la unica
#      cosa que le importa al engine nativo de Prisma.
#
#   2. Las dos etapas comparten libc por Prisma. `schema.prisma` declara el
#      generator sin `binaryTargets`, asi que Prisma compila el engine para la
#      plataforma que detecta durante `prisma generate`. Si se generase en
#      Alpine (musl) y se ejecutase en Debian (glibc) —o al reves— reventaria
#      con "Query engine binary for current platform could not be found", y lo
#      haria al primer acceso a la base de datos, no al arrancar: un contenedor
#      que parece sano hasta que alguien inicia sesion.
#
#      El COPY explicito de `.prisma` mas abajo es redundante, no obligatorio.
#      Se comprobo en el trazado real (`page.js.nft.json` lista 27 entradas de
#      Prisma, incluidos el `.node` del engine, `schema.prisma` y
#      `@prisma/client`), asi que standalone si lo incluye. Se mantiene porque
#      cuesta unos megas y cubre el dia que una version de Next cambie el
#      trazado, pero no se apoye nadie en ese COPY para dar por hecho que el
#      engine correcto esta ahi: eso lo garantiza la libc compartida.
#
#   3. Hay variables que se necesitan en BUILD, no solo en runtime. Ver el
#      bloque de ARG de la etapa builder.


# ---------------------------------------------------------------------------
# deps: solo el arbol de dependencias, en su propia capa.
#
# Copiando unicamente el manifiesto y el lockfile, esta capa se reaprovecha
# entre builds mientras no cambien las dependencias. Si se copiase todo el
# proyecto antes de instalar, cualquier cambio en un componente invalidaria la
# instalacion completa.
# ---------------------------------------------------------------------------
FROM oven/bun:1.3-debian AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile


# ---------------------------------------------------------------------------
# builder: `prisma generate` + `next build` de verdad.
# ---------------------------------------------------------------------------
FROM oven/bun:1.3-debian AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Variables necesarias EN BUILD. No es una lista defensiva; cada una falla de
# una forma distinta si se omite:
#
#   TMDB_API_KEY          `src/lib/tmdb.ts` lanza en carga de modulo si falta.
#                         Como ese modulo lo importan los server components de
#                         la portada y de las fichas, el build no falla "en una
#                         ruta": falla entero.
#   TMDB_BASE_URL         no esta protegida por ese throw, asi que si falta el
#                         build PASA y las URLs se construyen como
#                         "undefined/movie/...". Peor que fallar: se publica
#                         una imagen rota que parece correcta.
#   NEXT_PUBLIC_SITE_URL  al llevar prefijo NEXT_PUBLIC_ se inlinea en el
#                         bundle durante el build. Si no se pasa, la imagen
#                         queda cocida para siempre con el fallback
#                         `pixela-seven.vercel.app`, que es justamente el
#                         despliegue del que se esta huyendo. La consumen
#                         `layout.tsx`, `robots.ts` y `sitemap.ts`.
#   NEXT_PUBLIC_API_URL   mismo mecanismo de inlinado.
#   DATABASE_URL          `prisma generate` no la necesita, y las fichas usan
#                         `getMediaReviewsSafe`, que tolera la base de datos
#                         caida. Se pasa igual para no depender de esa suerte
#                         si algun dia una pagina prerenderizada consulta
#                         Prisma.
#
# Se declaran como ARG y no como ENV en la imagen final: un ARG vive solo
# durante el build y no queda en el historial de capas de la imagen que se
# publica.
ARG TMDB_API_KEY
ARG TMDB_BASE_URL="https://api.themoviedb.org/3"
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_API_URL
ARG DATABASE_URL

ENV TMDB_API_KEY=${TMDB_API_KEY} \
    TMDB_BASE_URL=${TMDB_BASE_URL} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    DATABASE_URL=${DATABASE_URL} \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

# `bun run build` ya es `prisma generate && next build` (ver package.json), asi
# que no se invoca `prisma generate` por separado: hacerlo lo ejecutaria dos
# veces.
RUN bun run build


# ---------------------------------------------------------------------------
# runner: lo minimo para servir.
#
# Node y no bun porque el `server.js` que emite `output: 'standalone'` esta
# escrito contra Node, y porque `engines` del proyecto pide node >= 20.
# `bookworm-slim` para casar con la libc de la etapa de build.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runner
WORKDIR /app

# HOSTNAME=0.0.0.0 no es decorativo: el server.js de standalone escucha en
# localhost por defecto, y desde fuera del contenedor eso es inalcanzable.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Usuario sin privilegios. Se crea antes de copiar para poder asignar la
# propiedad en el propio COPY y no pagar una capa extra con `chown -R`.
RUN groupadd --system --gid 1001 nodejs \
 && useradd --system --uid 1001 --gid nodejs nextjs

# El servidor autonomo trae ya sus dependencias trazadas: no se copia
# `node_modules` entero.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
# `static/` y `public/` quedan fuera del trazado y hay que copiarlos aparte.
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
# El cliente de Prisma con su engine nativo. Redundante a proposito: el trazado
# de standalone ya lo incluye (verificado en el .nft.json). Ver la decision 2.
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/.prisma ./node_modules/.prisma

# Carpeta de cache de ISR. Next la crea al primer render, pero si el directorio
# de trabajo pertenece a root el proceso no puede escribir y las paginas
# incrementales fallan en silencio.
RUN mkdir -p .next/cache && chown -R nextjs:nodejs .next

USER nextjs
EXPOSE 3000

# El healthcheck NO puede usar curl ni wget: `src/proxy.ts` mantiene una
# denylist de user-agents que incluye "curl/" y "wget/" y les responde 403, asi
# que el contenedor se marcaria unhealthy estando perfectamente sano. Se usa el
# fetch de Node con un user-agent propio, que no esta en esa lista.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/', {headers:{'user-agent':'pixela-healthcheck'}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
