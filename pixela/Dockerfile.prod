# syntax=docker/dockerfile:1

# Imagen de produccion. El `Dockerfile` de al lado sigue siendo el de
# desarrollo y no se toca: nunca ejecuta `build` y termina en
# `CMD ["bun", "run", "dev"]`, asi que servia para levantar el proyecto en
# local pero no para publicarlo.
#
# Tres decisiones gobiernan este fichero, y las tres salieron de intentar
# construirlo, no de razonarlo sobre el papel:
#
#   1. Las dos etapas usan Debian 13 (trixie). Se construye con bun (es el
#      gestor del proyecto) y se ejecuta con Node (el `server.js` de standalone
#      esta escrito contra Node, y `engines` pide node >= 20). La primera
#      version usaba `node:22-bookworm-slim` de runtime y ESTABA MAL:
#      `oven/bun:1.3.8-debian` es trixie con glibc 2.41 y bookworm trae glibc
#      2.36. glibc es compatible hacia atras, no hacia delante, asi que el
#      engine nativo de Prisma compilado en el builder no habria arrancado en el
#      runner. Y no habria fallado al construir ni al arrancar el contenedor,
#      sino al primer acceso a la base de datos.
#
#   2. La version de bun va clavada, no en el flotante `1.3`. `package.json`
#      declara `packageManager: bun@1.3.8`, y el tag `1.3` resolvia a 1.3.14,
#      que ademas fallaba al extraer el tarball de `next`. Un build reproducible
#      no depende de que hoy el tag flotante apunte a una version sana.
#
#   3. Las claves entran por secretos de BuildKit, no por ARG. Docker avisa de
#      esto explicitamente ("SecretsUsedInArgOrEnv") y tiene razon: un ARG queda
#      en los metadatos del build y un ENV se queda en la configuracion de la
#      capa. Con `--mount=type=secret` el valor existe solo mientras corre ese
#      RUN y no toca ninguna capa. Las `NEXT_PUBLIC_*` si van como ARG: se
#      inlinean en el bundle del navegador por definicion, o sea que son
#      publicas de todas formas.


# ---------------------------------------------------------------------------
# deps: solo el arbol de dependencias, en su propia capa.
#
# Copiando unicamente el manifiesto y el lockfile, esta capa se reaprovecha
# entre builds mientras no cambien las dependencias. Si se copiase todo el
# proyecto antes de instalar, cualquier cambio en un componente invalidaria la
# instalacion completa.
# ---------------------------------------------------------------------------
FROM oven/bun:1.3.8-debian AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile


# ---------------------------------------------------------------------------
# builder: `prisma generate` + `next build` de verdad.
# ---------------------------------------------------------------------------
FROM oven/bun:1.3.8-debian AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Valores publicos. Van como ARG porque no son secretos: las dos primeras se
# inlinean en el bundle que descarga el navegador, y la URL base de TMDB es
# publica.
#
# NEXT_PUBLIC_SITE_URL merece un aviso: si no se pasa, la imagen queda cocida
# para siempre con el fallback `http://localhost:3000`, y el sitemap y las
# tarjetas sociales anunciarian esa URL. La leen `layout.tsx`, `robots.ts` y
# `sitemap.ts`, las tres en build.
ARG TMDB_BASE_URL="https://api.themoviedb.org/3"
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_API_URL

ENV TMDB_BASE_URL=${TMDB_BASE_URL} \
    NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

# `bun run build` ya es `prisma generate && next build` (ver package.json), asi
# que no se invoca `prisma generate` por separado: hacerlo lo ejecutaria dos
# veces.
#
# Las dos claves entran como secretos y viven solo durante esta orden:
#
#   TMDB_API_KEY  `src/lib/tmdb.ts` lanza en carga de modulo si falta, y ese
#                 modulo lo importan los server components de la portada y de
#                 las fichas. Sin ella el build no falla "en una ruta": falla
#                 entero.
#   DATABASE_URL  `prisma generate` no la necesita y las fichas usan
#                 `getMediaReviewsSafe`, que tolera la base de datos caida. Se
#                 pasa igual para no depender de esa suerte si algun dia una
#                 pagina prerenderizada consulta Prisma.
RUN --mount=type=secret,id=tmdb_api_key \
    --mount=type=secret,id=database_url \
    TMDB_API_KEY="$(cat /run/secrets/tmdb_api_key)" \
    DATABASE_URL="$(cat /run/secrets/database_url)" \
    bun run build


# ---------------------------------------------------------------------------
# runner: lo minimo para servir.
# ---------------------------------------------------------------------------
FROM node:22-trixie-slim AS runner
WORKDIR /app

# HOSTNAME=0.0.0.0 no es decorativo: el server.js de standalone escucha en
# localhost por defecto, y desde fuera del contenedor eso es inalcanzable.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Usuario sin privilegios. Se crea antes de copiar para poder asignar la
# propiedad en el propio COPY y no pagar una capa extra con `chown -R`.
RUN groupadd --system --gid 1001 nodejs \
 && useradd --system --uid 1001 --gid nodejs nextjs

# El servidor autonomo trae ya sus dependencias trazadas: no se copia
# `node_modules` entero.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
# `static/` y `public/` quedan fuera del trazado y hay que copiarlos aparte.
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Carpeta de cache de ISR. Next la crea al primer render, pero si el directorio
# de trabajo pertenece a root el proceso no puede escribir y las paginas
# incrementales fallan en silencio.
RUN mkdir -p .next/cache && chown -R nextjs:nodejs .next

USER nextjs
EXPOSE 3000

# El healthcheck NO puede usar curl ni wget: `src/proxy.ts` mantiene una
# denylist de user-agents que incluye "curl/" y "wget/" y les responde 403, asi
# que el contenedor se marcaria unhealthy estando perfectamente sano. Se usa el
# fetch de Node con un user-agent propio, que no esta en esa lista.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/', {headers:{'user-agent':'pixela-healthcheck'}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server.js"]
