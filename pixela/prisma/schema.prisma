datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int       @id @default(autoincrement()) @map("user_id")
  name          String
  email         String    @unique
  password      String?   // Opcional para logins sociales o si migramos solo hash
  photoUrl      String?   @map("photo_url") @db.Text
  coverImage    String?   @map("cover_image") @db.Text
  emailVerified DateTime? @map("email_verified_at")
  isAdmin       Boolean   @default(false) @map("is_admin")
  /// Cuándo aceptó las condiciones y declaró tener la edad mínima. Nulo en
  /// cuentas anteriores a la casilla.
  termsAcceptedAt DateTime? @map("terms_accepted_at")
  /// Se incrementa para invalidar todas las sesiones abiertas: cambio de
  /// contraseña o "cerrar sesión en todos los dispositivos". Cada JWT lleva la
  /// versión con la que se emitió y `auth.ts` lo rechaza si ya no coincide.
  tokenVersion  Int       @default(0) @map("token_version")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  favorites     Favorite[]
  reviews       Review[]
  libraryItems  LibraryItem[]
  lists         List[]

  @@map("users")
}

model Favorite {
  id        Int      @id @default(autoincrement()) @map("favorite_id")
  userId    Int      @map("user_id")
  itemType  ItemType @map("item_type") // Enum: MOVIE, SERIES
  tmdbId    BigInt   @map("tmdb_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, tmdbId])
  @@map("favorites")
}

model Review {
  id        Int      @id @default(autoincrement()) @map("review_id")
  userId    Int      @map("user_id")
  itemType  ItemType @map("item_type")
  tmdbId    BigInt   @map("tmdb_id")
  rating    Decimal  @db.Decimal(3, 1)
  review    String?  @db.Text
  /// `false` = «solo para mí»: no sale en la ficha ni para nadie más.
  isPublic  Boolean  @default(true) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, tmdbId])
  @@map("reviews")
}

enum ItemType {
  movie
  series
}

enum WatchStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  DROPPED
}

model LibraryItem {
  id        Int         @id @default(autoincrement()) @map("library_item_id")
  userId    Int         @map("user_id")
  itemType  ItemType    @map("item_type")
  tmdbId    BigInt      @map("tmdb_id")
  status    WatchStatus @default(PLAN_TO_WATCH)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, tmdbId])
  @@map("library_items")
}

enum ListVisibility {
  /// Solo la ve quien la creó.
  PRIVATE
  /// La ve quien tenga el enlace; no se indexa ni sale en ningún listado.
  LINK
  /// Pública: se puede enlazar y compartir abiertamente.
  PUBLIC
}

/// Listas con nombre: «Viernes en familia», «Ciclo coming of age». La feature
/// más votada de la ronda 2 del beta test.
model List {
  id          Int            @id @default(autoincrement()) @map("list_id")
  userId      Int            @map("user_id")
  name        String         @db.VarChar(80)
  description String?        @db.VarChar(500)
  visibility  ListVisibility @default(PRIVATE)
  /// Identificador de la URL pública (`/listas/<shareId>`). Aleatorio para que
  /// una lista «con enlace» no se pueda adivinar recorriendo ids.
  shareId     String         @unique @map("share_id") @db.VarChar(24)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]

  @@index([userId])
  @@map("lists")
}

model ListItem {
  id       Int      @id @default(autoincrement()) @map("list_item_id")
  listId   Int      @map("list_id")
  itemType ItemType @map("item_type")
  tmdbId   BigInt   @map("tmdb_id")
  /// Orden manual dentro de la lista (0, 1, 2…).
  position Int
  /// Por qué está en la lista: «para la sesión del jueves».
  note     String?  @db.VarChar(280)
  addedAt  DateTime @default(now()) @map("added_at")

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, itemType, tmdbId])
  @@index([listId, position])
  @@map("list_items")
}
