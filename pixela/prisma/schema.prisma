datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int       @id @default(autoincrement()) @map("user_id")
  name          String
  email         String    @unique
  password      String?   // Opcional para logins sociales o si migramos solo hash
  photoUrl      String?   @map("photo_url") @db.Text
  coverImage    String?   @map("cover_image") @db.Text
  emailVerified DateTime? @map("email_verified_at")
  isAdmin       Boolean   @default(false) @map("is_admin")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  favorites     Favorite[]
  reviews       Review[]
  libraryItems  LibraryItem[]

  @@map("users")
}

model Favorite {
  id        Int      @id @default(autoincrement()) @map("favorite_id")
  userId    Int      @map("user_id")
  itemType  ItemType @map("item_type") // Enum: MOVIE, SERIES
  tmdbId    BigInt   @map("tmdb_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, tmdbId])
  @@map("favorites")
}

model Review {
  id        Int      @id @default(autoincrement()) @map("review_id")
  userId    Int      @map("user_id")
  itemType  ItemType @map("item_type")
  tmdbId    BigInt   @map("tmdb_id")
  rating    Decimal  @db.Decimal(3, 1)
  review    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, tmdbId])
  // Reseñas de una ficha (`getMediaReviews`). El índice único empieza por
  // `userId` y no sirve para filtrar solo por título: sin este, cada
  // regeneración de una ficha recorría la tabla entera.
  @@index([itemType, tmdbId, createdAt(sort: Desc)])
  @@map("reviews")
}

enum ItemType {
  movie
  series
}

enum WatchStatus {
  PLAN_TO_WATCH
  WATCHING
  COMPLETED
  DROPPED
}

model LibraryItem {
  id        Int         @id @default(autoincrement()) @map("library_item_id")
  userId    Int         @map("user_id")
  itemType  ItemType    @map("item_type")
  tmdbId    BigInt      @map("tmdb_id")
  status    WatchStatus @default(PLAN_TO_WATCH)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, tmdbId])
  @@map("library_items")
}
